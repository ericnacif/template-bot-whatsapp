# ──────────────────────────────────────────────
# Comportamento do bot
# ──────────────────────────────────────────────

# Arquivo JSON com o fluxo ativo
BOT_FLOW_FILE=config/flows/default.json

# Tempo de vida da sessão de conversa (minutos)
SESSION_TTL_MINUTES=30

# Onde guardar as sessões: memory (padrão) ou redis
SESSION_DRIVER=memory

# Usado apenas quando SESSION_DRIVER=redis
REDIS_URL=redis://127.0.0.1:6379

# Rate limit: máximo de mensagens por janela de tempo
RATE_LIMIT_WINDOW_SECONDS=10
RATE_LIMIT_MAX_MESSAGES=5

# Nível de log: error | warn | info | debug
LOG_LEVEL=info

# O corpo das mensagens nunca é logado por padrão
LOG_MESSAGE_BODY=false

# Opcional: mantém o mesmo hash anônimo entre reinícios
LOG_HASH_SECRET=

# Captura de leads: file ou memory
LEAD_STORE_DRIVER=file
LEAD_STORE_PATH=data/leads.ndjson

# Endpoint local de saúde
HEALTH_ENABLED=true
HEALTH_PORT=3000

# Reconexão automática ao WhatsApp
RECONNECT_INITIAL_SECONDS=5
RECONNECT_MAX_SECONDS=60

# ──────────────────────────────────────────────
# Integração com IA (opcional) — preencha apenas o provedor escolhido
# ──────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

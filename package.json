{
    "name": "template-bot-whatsapp",
    "version": "1.1.0",
    "description": "Boilerplate Node.js para bots de WhatsApp com fluxos, sessões, Redis e testes",
    "main": "index.js",
    "scripts": {
        "start": "node index.js",
        "dev": "node --watch index.js",
        "simulate": "node scripts/simulate.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "check": "npm run lint && prettier --check . && npm test",
        "audit": "npm audit --omit=dev",
        "format": "prettier --write .",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ericnacif/template-bot-whatsapp.git"
    },
    "keywords": [
        "whatsapp",
        "whatsapp-bot",
        "nodejs",
        "automation",
        "chatbot",
        "redis",
        "boilerplate"
    ],
    "author": "Eric Nacif",
    "license": "MIT",
    "type": "commonjs",
    "bugs": {
        "url": "https://github.com/ericnacif/template-bot-whatsapp/issues"
    },
    "homepage": "https://github.com/ericnacif/template-bot-whatsapp#readme",
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "dotenv": "^16.6.1",
        "qrcode-terminal": "^0.12.0",
        "redis": "^4.7.0",
        "whatsapp-web.js": "^1.34.7"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.3",
        "@commitlint/config-conventional": "^20.5.3",
        "@eslint/js": "^9.39.5",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^9.1.0",
        "globals": "^15.14.0",
        "husky": "^9.1.7",
        "prettier": "^3.9.6",
        "vitest": "^4.1.11"
    }
}
